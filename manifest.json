{
  "id": "hunyuan_t2i_turbo",
  "name": "Hunyuan T2I Turbo",
  "type": "model",
  "source": "https://github.com/iammojogo-sudo/hunyuan_t2i_turbo_modly",
  "description": "HunyuanDiT v1.2 distilled text-to-image. Connect any image node as a placeholder input, type your prompt in the field below.",
  "version": "0.1.0",
  "author": "iammojogo",
  "generator_class": "HunyuanT2IGenerator",
  "vram_gb": 6,
  "tags": ["text-to-image", "diffusion"],
  "nodes": [
    {
      "id": "generate",
      "name": "Generate Image",
      "input": "image",
      "output": "image",
      "hf_repo": "Tencent-Hunyuan/HunyuanDiT-v1.2-Diffusers-Distilled",
      "download_check": "model_index.json",
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "a beautiful landscape"
        },
        {
          "id": "num_inference_steps",
          "label": "Steps",
          "type": "select",
          "default": 20,
          "options": [
            { "value": 10, "label": "Fast (10)" },
            { "value": 20, "label": "Balanced (20)" },
            { "value": 30, "label": "Quality (30)" }
          ]
        },
        {
          "id": "height",
          "label": "Height",
          "type": "select",
          "default": 1024,
          "options": [
            { "value": 512,  "label": "512" },
            { "value": 768,  "label": "768" },
            { "value": 1024, "label": "1024" }
          ]
        },
        {
          "id": "width",
          "label": "Width",
          "type": "select",
          "default": 1024,
          "options": [
            { "value": 512,  "label": "512" },
            { "value": 768,  "label": "768" },
            { "value": 1024, "label": "1024" }
          ]
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": -1,
          "min": -1,
          "max": 2147483647,
          "tooltip": "-1 for random"
        }
      ]
    }
  ]
}
