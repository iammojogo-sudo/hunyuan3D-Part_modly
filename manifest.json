{
  "id": "hunyuan_t2i_turbo",
  "name": "Hunyuan T2I Turbo",
  "type": "model",
  "source": "https://huggingface.co/TencentARC/HunyuanDiT-Turbo",
  "description": "Text-to-image generation using Hunyuan T2I Turbo.",
  "version": "0.1.0",
  "author": "yourname",
  "vram_gb": 6,
  "tags": ["text-to-image", "diffusion"],
  "nodes": [
    {
      "id": "generate",
      "name": "Generate Image",
      "input": "text",
      "output": "image",
      "hf_repo": "TencentARC/HunyuanDiT-Turbo",
      "download_check": "model_index.json",
      "params_schema": [
        {
          "id": "num_inference_steps",
          "label": "Inference Steps",
          "type": "int",
          "default": 20
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 42
        },
        {
          "id": "height",
          "label": "Height",
          "type": "int",
          "default": 512
        },
        {
          "id": "width",
          "label": "Width",
          "type": "int",
          "default": 512
        }
      ]
    }
  ],
  "generator_class": "HunyuanT2IGenerator"
}
